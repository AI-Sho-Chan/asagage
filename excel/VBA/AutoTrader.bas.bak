Private Function RealTimeHeaderList() As Variant

    RealTimeHeaderList = Array("Ticker", HeaderNameJP(), HeaderJValueJP(), HeaderJGapJP(), HeaderSignalStatusJP(), HeaderSignalKindJP(), HeaderLastJP(), HeaderVwapJP(), HeaderPrevCloseJP(), HeaderPreopenBidJP(), HeaderPreopenAskJP(), HeaderPreopenMidJP(), HeaderLiveGapBpJP(), HeaderLiveGapBucketJP(), HeaderLiveGapActionJP())

End Function



Private Function CandidateHeaderList() As Variant

    CandidateHeaderList = Array("TickerSrc", "Selected", "SignalMode", "Session", "ATR_n", "TPk", "SLk", "J_th", "ForwardPF", "ForwardTrades", "ForwardWin", "MaxDD", "WinCI_L", "WinCI_H", "ExpBootMean", "ExpBootLow", "ExpBootHigh", "ForwardAvgBars", "GapBucket", "GapRule", "GapSummary", "DynamicQty", "PlanTag", "EntryBuyPx", "EntrySellPx", "TP_price", "SL_price", "EntryStatus", "EntrySide")

End Function
Private Function EnsurePendingInfo(ByVal ticker As String) As Object

    If pendingStraddles Is Nothing Then Set pendingStraddles = CreateObject("Scripting.Dictionary")

    If pendingStraddles.Exists(ticker) Then

        Set EnsurePendingInfo = pendingStraddles(ticker)

    Else

        Dim info As Object: Set info = CreateObject("Scripting.Dictionary")

        pendingStraddles(ticker) = info

        Set EnsurePendingInfo = info

    End If

End Function



Private Sub RemovePendingInfo(ByVal ticker As String)

    If Not pendingStraddles Is Nothing Then

        If pendingStraddles.Exists(ticker) Then pendingStraddles.Remove ticker

    End If

End Sub



Private Function EnsureActiveInfo(ByVal ticker As String) As Object

    If activeStraddles Is Nothing Then Set activeStraddles = CreateObject("Scripting.Dictionary")

    If activeStraddles.Exists(ticker) Then

        Set EnsureActiveInfo = activeStraddles(ticker)

    Else

        Dim info As Object: Set info = CreateObject("Scripting.Dictionary")

        activeStraddles(ticker) = info

        Set EnsureActiveInfo = info

    End If

End Function



Private Sub RemoveActiveInfo(ByVal ticker As String)

    If Not activeStraddles Is Nothing Then

        If activeStraddles.Exists(ticker) Then activeStraddles.Remove ticker

    End If

End Sub



Private Function GetTickSize(ByVal price As Double) As Double

    If price <= 0 Then

        GetTickSize = 0.1

        Exit Function

    End If

    Select Case price

        Case Is < 3000

            GetTickSize = 1

        Case Is < 5000

            GetTickSize = 5

        Case Is < 30000

            GetTickSize = 10

        Case Is < 50000

            GetTickSize = 50

        Case Is < 300000

            GetTickSize = 100

        Case Is < 500000

            GetTickSize = 500

        Case Is < 3000000

            GetTickSize = 1000

        Case Is < 5000000

            GetTickSize = 5000

        Case Else

            GetTickSize = 10000

    End Select

End Function

Private Function AlignToTick(ByVal price As Double, ByVal tick As Double) As Double

    If tick <= 0 Then

        AlignToTick = price

        Exit Function

    End If

    On Error GoTo fallback

    Dim ratio As Double

    ratio = price / tick

    AlignToTick = Application.WorksheetFunction.Round(ratio, 0) * tick

    Exit Function

fallback:

    AlignToTick = Round(price / tick, 0) * tick

End Function



Private Function DashboardHeaderList() As Variant

    Dim rt As Variant: rt = RealTimeHeaderList()

    Dim cand As Variant: cand = CandidateHeaderList()

    Dim total() As Variant

    Dim i As Long, offset As Long

    ReDim total(0 To UBound(rt) + UBound(cand) + 1)

    For i = 0 To UBound(rt)

        total(offset) = rt(i)

        offset = offset + 1

    Next i

    Dim j As Long

    For j = 0 To UBound(cand)

        total(offset) = cand(j)

        offset = offset + 1

    Next j

    DashboardHeaderList = total

End Function





